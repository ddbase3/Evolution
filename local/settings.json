{
    "connection": {
        "evolution-llm": {
            "id": "evolution-llm",
            "name": "Evolution OpenAI",
            "type": "http",
            "driver": "http",
            "baseUrl": "https://api.openai.com",
            "auth": {
                "type": "bearer",
                "headerName": "Authorization",
                "secret": {
                    "mode": "file",
                    "path": "/srv/www/html/misc/evolution/local/secret/openai.key"
                }
            },
            "timeoutSeconds": 120,
            "scope": "global",
            "enabled": true,
            "options": []
        }
    },
    "service-llm": {
        "evolution-llm": {
            "id": "evolution-llm",
            "name": "Evolution OpenAI",
            "serviceType": "llm",
            "connection": "evolution-llm",
            "driver": "openai-chat",
            "model": "gpt-4.1",
            "enabled": true,
            "options": {
                "temperature": 0.2,
                "maxTokens": 16000,
                "topP": 1
            }
        }
    },
    "agent-component-preset": {
        "evolution-chat": {
            "id": "evolution-chat",
            "label": "Evolution Chat Model",
            "type": "configuredchatmodelagentresource",
            "enabled": true,
            "capabilities": [
                "chatmodel"
            ],
            "config": {
                "service": {
                    "mode": "fixed",
                    "value": "evolution-llm"
                }
            },
            "docks": []
        },
        "evolution-workspace": {
            "id": "evolution-workspace",
            "label": "Evolution Workspace",
            "type": "evolutionworkspaceagenttool",
            "enabled": true,
            "capabilities": [
                "tool"
            ],
            "config": [],
            "docks": []
        }
    },
    "tool-profile": {
        "evolution": {
            "id": "evolution",
            "label": "Evolution",
            "description": "Workspace inspection and approved BASE3 source evolution tools.",
            "enabled": true,
            "internal_enabled": true,
            "mcp_enabled": false,
            "tools": [
                "evolution-workspace"
            ]
        }
    },
    "agent": {
        "evolution": {
            "enabled": true,
            "label": "Evolution",
            "chatmodel": "evolution-chat",
            "orchestrator_profile": "deliberate",
            "tool_profiles": [
                "evolution"
            ],
            "memory_profile": "",
            "context_profile": "",
            "system_prompt": ""
        }
    }
}
