{
    "connection": {
        "evolution-llm": {
            "id": "evolution-llm",
            "name": "Evolution OpenAI-Compatible LLM",
            "type": "http",
            "driver": "http",
            "baseUrl": "https://your-openai-compatible-endpoint.example",
            "auth": {
                "type": "bearer",
                "headerName": "Authorization",
                "secret": {
                    "mode": "file",
                    "path": "/srv/www/html/misc/evolution/local/secret/evolution-llm.key"
                }
            },
            "timeoutSeconds": 120,
            "scope": "global",
            "enabled": true,
            "options": []
        }
    },
    "service-llm": {
        "evolution-llm": {
            "id": "evolution-llm",
            "name": "Evolution OpenAI-Compatible LLM",
            "serviceType": "llm",
            "connection": "evolution-llm",
            "driver": "openai-compatible-chat",
            "model": "replace-with-provider-model-id",
            "enabled": true,
            "options": {
                "temperature": 0.2,
                "maxTokens": 16000,
                "topP": 1
            }
        }
    },
    "agent-component-preset": {
        "evolution-chat": {
            "id": "evolution-chat",
            "label": "Evolution Chat Model",
            "type": "configuredchatmodelagentresource",
            "enabled": true,
            "capabilities": [
                "chatmodel"
            ],
            "config": {
                "service": {
                    "mode": "fixed",
                    "value": "evolution-llm"
                }
            },
            "docks": []
        },
        "evolution-workspace": {
            "id": "evolution-workspace",
            "label": "Evolution Workspace",
            "type": "evolutionworkspaceagenttool",
            "enabled": true,
            "capabilities": [
                "tool"
            ],
            "config": [],
            "docks": []
        }
    },
    "tool-profile": {
        "evolution": {
            "id": "evolution",
            "label": "Evolution",
            "description": "Workspace inspection and approved BASE3 source evolution tools.",
            "enabled": true,
            "internal_enabled": true,
            "mcp_enabled": false,
            "tools": [
                "evolution-workspace"
            ]
        }
    },
    "agent": {
        "evolution": {
            "enabled": true,
            "label": "Evolution",
            "chatmodel": "evolution-chat",
            "orchestrator_profile": "evolution",
            "tool_profiles": [
                "evolution"
            ],
            "memory_profile": "",
            "context_profile": "",
            "system_prompt": ""
        }
    },
    "agent-orchestrator-profile": {
        "evolution": {
            "label": "Evolution governed",
            "description": "Long-running governed orchestration for BASE3 source analysis and approved mutations.",
            "enabled": true,
            "mode": "governed",
            "max_tool_loops": 32,
            "model_decision": {
                "strategy": "native-model-decision",
                "repair_enabled": false,
                "confidence_threshold": 0.7
            },
            "optional_stages": {
                "semantic-verification": false
            }
        }
    }
}
