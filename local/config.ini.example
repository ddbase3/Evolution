; Add/merge these sections into the project cnf/config.ini.

[directories]
; JsonSettingsStore writes to <data>/cnf/settings.json
data = "/path/to/base3/local"

[evolution]
; BASE3 application root. Evolution may read this tree, but source writes are
; hard-restricted to plugin/EvolutionWorkspace.
workspace = "/path/to/base3"
git_required = true
agent = "evolution"
