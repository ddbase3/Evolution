{
    "connection": {
        "evolution-llm": {
            "id": "evolution-llm",
            "name": "Evolution OpenAI",
            "type": "http",
            "driver": "http",
            "baseUrl": "https://api.openai.com",
            "auth": {
                "type": "bearer",
                "headerName": "Authorization",
                "secret": {
                    "mode": "file",
                    "path": "/srv/www/html/misc/evolution/local/secret/openai.key"
                }
            },
            "timeoutSeconds": 120,
            "scope": "global",
            "enabled": true,
            "options": []
        }
    },
    "service-llm": {
        "evolution-llm": {
            "id": "evolution-llm",
            "name": "Evolution OpenAI",
            "serviceType": "llm",
            "connection": "evolution-llm",
            "driver": "openai-chat",
            "model": "gpt-4.1",
            "enabled": true,
            "options": {
                "temperature": 0.2,
                "maxTokens": 16000,
                "topP": 1
            }
        }
    },
    "agent-component-preset": {
        "evolution-chat": {
            "id": "evolution-chat",
            "label": "Evolution Chat Model",
            "type": "configuredchatmodelagentresource",
            "enabled": true,
            "capabilities": [
                "chatmodel"
            ],
            "config": {
                "service": {
                    "mode": "fixed",
                    "value": "evolution-llm"
                }
            },
            "docks": []
        },
        "evolution-workspace": {
            "id": "evolution-workspace",
            "label": "Evolution Workspace",
            "type": "evolutionworkspaceagenttool",
            "enabled": true,
            "capabilities": [
                "tool"
            ],
            "config": [],
            "docks": []
        }
    },
    "tool-profile": {
        "evolution": {
            "id": "evolution",
            "label": "Evolution",
            "description": "Workspace inspection and approved BASE3 source evolution tools.",
            "enabled": true,
            "internal_enabled": true,
            "mcp_enabled": false,
            "tools": [
                "evolution-workspace"
            ]
        }
    },
    "agent": {
        "evolution": {
            "enabled": true,
            "label": "Evolution",
            "chatmodel": "evolution-chat",
            "orchestrator_profile": "evolution",
            "tool_profiles": [
                "evolution"
            ],
            "memory_profile": "",
            "context_profile": "",
            "system_prompt": ""
        }
    },
    "agent-orchestrator-profile": {
        "evolution": {
            "label": "Evolution governed",
            "description": "Long-running governed orchestration for BASE3 source analysis and approved mutations.",
            "enabled": true,
            "mode": "governed",
            "max_tool_loops": 32,
            "model_decision": {
                "strategy": "native-model-decision",
                "repair_enabled": false,
                "confidence_threshold": 0.7
            },
            "optional_stages": {
                "capability-discovery": true,
                "capability-selection": true,
                "ai-capability-selection": false,
                "context-compaction": true,
                "semantic-verification": false
            },
            "deliberate_planning": true,
            "capability_selection": {
                "enabled": true,
                "strategy": "hybrid",
                "max_tools": 8,
                "select_all_threshold": 8,
                "sticky": true
            }
        }
    }
}
